{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Exportiere zu DOCX",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/convert-to-docx.sh",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Exportiere ausgewählte MD zu DOCX",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/convert-to-docx-single.sh",
      "args": ["${file}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Exportiere markierten Text zu DOCX",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/convert-text-to-docx.sh",
      "args": [],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "stdin": true
      }
    },
    {
      "label": "Lektorat starten",
      "type": "shell",
      "command": "./Skripte/run_lektorat.sh",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Audio transkribieren mit Dialogerkennung",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/Skripte/transcribe_with_dialogs.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Aktuelle Audiodatei transkribieren",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/Skripte/transcribe_with_dialogs.py",
        "${file}"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
