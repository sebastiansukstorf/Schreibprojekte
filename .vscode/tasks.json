{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Exportiere zu DOCX",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/convert-to-docx.sh",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Exportiere ausgewählte MD zu DOCX",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/convert-to-docx-single.sh",
      "args": ["${file}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Exportiere markierten Text zu DOCX",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/convert-text-to-docx.sh",
      "args": [],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "stdin": true
      }
    },
    {
      "label": "Lektorat starten",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/manuskript",
      "args": ["lektorat", "${file}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Vollständiges Szenenlektorat",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/lektorat-szene.sh",
      "args": ["${file}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Teil-/Aktlektorat",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/lektorat-teil.sh",
      "args": ["${input:projektordner}", "--start", "${input:startnummer}", "--end", "${input:endnummer}", "--label", "${input:teilname}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Gesamtromanlektorat",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/lektorat-gesamt.sh",
      "args": ["${input:projektordner}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Lektorat-Nachtlauf starten",
      "type": "shell",
      "command": "${workspaceFolder}/Skripte/lektorat-nacht.sh",
      "args": ["${input:projektordner}"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "projektordner",
      "type": "promptString",
      "description": "Pfad zum Manuskriptprojekt"
    },
    {
      "id": "startnummer",
      "type": "promptString",
      "description": "Erste Dateinummer des Teils",
      "default": "100"
    },
    {
      "id": "endnummer",
      "type": "promptString",
      "description": "Letzte Dateinummer des Teils",
      "default": "199"
    },
    {
      "id": "teilname",
      "type": "promptString",
      "description": "Bezeichnung für den Bericht",
      "default": "teil_1"
    }
  ]
}
